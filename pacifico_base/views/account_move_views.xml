<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="inherit_view_move_form" model="ir.ui.view">
        <field name="name">inherit.view.move.form</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//tree//field[@name='name']" position="after">
                <field name="statement" optional="hide"/>
                <field name="container" optional="hide"/>
                <field name="receipt" optional="show"/>
                <field name="item" optional="show"/>
            </xpath>
        </field>
    </record>

</odoo>