<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="inherit_view_order_form" model="ir.ui.view">
        <field name="name">inherit.view.order.form</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"></field>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='sale_total']" position="inside">
                <div class="oe_subtotal_footer_separator oe_inline o_td_label">
                    <label for="quantity_total" />
                </div>
                <field name="quantity_total" nolabel="1" class="oe_subtotal_footer_separator"/>
            </xpath>
            <xpath expr="//tree//field[@name='name']" position="after">
                <field name="statement" optional="hide"/>
                <field name="container" optional="hide"/>
                <field name="receipt" optional="show"/>
                <field name="item" optional="show"/>
            </xpath>
        </field>
    </record>

</odoo>