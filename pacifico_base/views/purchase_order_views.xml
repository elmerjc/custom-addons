<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="inherit_purchase_order_form" model="ir.ui.view">
        <field name="name">inherit.purchase.order.form</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//tree//field[@name='product_id']" position="after">
                <field name="statement" optional="hide"/>
                <field name="container" optional="hide"/>
                <field name="receipt" optional="show"/>
                <field name="item" optional="show"/>
            </xpath>
        </field>
    </record>

</odoo>