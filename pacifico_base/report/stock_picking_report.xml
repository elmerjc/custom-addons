<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_delivery_pacifico">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="pacifico_base.stock_picking_layout_custom">
                    <div id="header" class="row border-radius text-12 p-2">
                        <div class="col-8">
                            <dl class="row mb-0">
                                <dt class="col-2 mb-0">
                                    <strong>Pedido:</strong>
                                </dt>
                                <dd class="col-10 mb-0">
                                    <span t-field="o.origin"/>
                                </dd>
                            </dl>
                            <dl class="row mb-0">
                                <dt class="col-2 mb-0">
                                    <strong>Cliente:</strong>
                                </dt>
                                <dd class="col-10 mb-0">
                                    <span t-field="o.partner_id.name"/>
                                </dd>
                            </dl>
                        </div>
                        <div class="col-4">
                            <dl class="row mb-0">
                                <dt class="col-4 mb-0">
                                    <strong>Fecha Programada:</strong>
                                </dt>
                                <dd class="col-8 mb-0">
                                    <span t-field="o.scheduled_date" t-options='{"widget": "date","format": "dd/MM/yyyy"}'/>
                                </dd>
                            </dl>
                        </div>
                    </div>
                    <div id="body" class="text-14 mt-2">
                        <table class="table-custom mb-2" name="table_lines">
                            <thead>
                                <th name="th_item" class="text-start"
                                    t-att-style="'width:3%;' + 'background-color: %s;' % o.company_id.primary_color or 'black'">Item</th>
                                <th name="th_product" class="text-start"
                                    t-att-style="'width:60%;' + 'background-color: %s;' % o.company_id.primary_color or 'black'">Producto</th>
                                <th name="th_price_unit" class="text-end"
                                    t-att-style="'width:5%;' + 'background-color: %s;' % o.company_id.primary_color or 'black'">Item</th>
                                <th name="th_subtotal" class="text-end"
                                    t-att-style="'width:10%;' + 'background-color: %s;' % o.company_id.primary_color or 'black'">Cantidad</th>
                            </thead>
                            <tbody>
                                <t t-set="item" t-value="0"/>
                                <t t-set="total_quantity" t-value="0"/>
                                <tr t-foreach="o.move_ids_without_package" t-as="l">
                                    <t t-set="item" t-value="item + 1"/>
                                    <t t-set="total_quantity" t-value="total_quantity + l.quantity"/>
                                    <td>
                                        <span t-esc="item"/>
                                    </td>
                                    <td name="td_product_description">
                                        <span t-field="l.product_id.display_name"/>
                                    </td>
                                    <td class="text-end">
                                        <span t-field="l.product_id.item"/>
                                    </td>
                                    <td class="text-end">
                                        <span t-esc="int(l.quantity)"/> <span t-field="l.product_uom.name"/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                    <div class="row text-14 mt-1" style="page-break-inside: avoid;">
                        <div class="col-4 offset-8">
                            <table class="table-border" name="table_totals" style="width:100%;">
                                <tr class="border-black o_subtotal">
                                    <td><strong t-att-style="'color: %s;' % o.company_id.primary_color or 'black'">Cantidad Total</strong></td>
                                    <td class="text-end">
                                        <span t-esc="int(total_quantity)"/>
                                    </td>
                                </tr>
                            </table>
                        </div>
                    </div>
                    <div class="row mt32" style="page-break-inside: avoid;">
                        <div class="col-12">
                            <p class="text-sm font-italic text-justify">
                            Una vez firmado el presente documento, se entenderá como entregado en conformidad, no admitiéndose posteriormente reclamos ni observaciones.
                            </p>
                        </div>
                    </div>

                    <div class="row mt64" style="page-break-inside: avoid;">
                        <div class="col-6">
                        </div>
                        <div class="col-6 text-center mt64">
                            <div style="border-top: 1px solid black; margin-top: 50px; width: 80%; margin-left: auto; margin-right: auto; padding-top: 10px;">
                                <strong><span t-field="o.partner_id.name"/></strong><br />
                                <strong><span t-field="o.partner_id.vat"/></strong>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <record id="paperformat_delivery_pacifico" model="report.paperformat">
        <field name="name">Paper Format Pacifico</field>
        <field name="default" eval="True" />
        <field name="format">A4</field>
        <field name="page_height">0</field>
        <field name="page_width">0</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">40</field>
        <field name="margin_bottom">10</field>
        <field name="margin_left">7</field>
        <field name="margin_right">7</field>
        <field name="header_line" eval="False" />
        <field name="header_spacing">35</field>
        <field name="dpi">90</field>
    </record>

    <record id="action_report_delivery_pacifico" model="ir.actions.report">
        <field name="name">Detalle de Entrega</field>
        <field name="model">stock.picking</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">pacifico_base.report_delivery_pacifico</field>
        <field name="report_file">pacifico_base.report_delivery_pacifico</field>
        <field name="print_report_name">'Detalle de Entrega - %s - %s' % (object.origin, object.partner_id.name or '')</field>
        <field name="binding_model_id" ref="stock.model_stock_picking"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="paperformat_delivery_pacifico"/>
    </record>
</odoo>
